/* DrawLite - Win32 Tutorial
 * Chapter 11 - Fill, picker and eraser
 */
#include <windows.h>
#include "resource.h"

// The application icon. Windows uses the lowest numbered icon as the exe's icon.
IDI_APP ICON "drawlite.ico"

// The manifest. Resource type 24 is RT_MANIFEST, and 1 is its id.
1 24 "app.manifest"

// Main menu
IDM_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",    IDM_FILE_NEW
        MENUITEM "&Open...\tCtrl+O", IDM_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",   IDM_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",           IDM_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",   IDM_EDIT_UNDO, GRAYED
        MENUITEM "&Redo\tCtrl+Y",   IDM_EDIT_REDO, GRAYED
    END
    POPUP "&Options"
    BEGIN
        POPUP "&Brush Size"
        BEGIN
            MENUITEM "&1 pixel",    IDM_BRUSH_1
            MENUITEM "&2 pixels",   IDM_BRUSH_2
            MENUITEM "&4 pixels",   IDM_BRUSH_4
            MENUITEM "&8 pixels",   IDM_BRUSH_8
            MENUITEM "1&6 pixels",  IDM_BRUSH_16
            MENUITEM "&32 pixels",  IDM_BRUSH_32
        END
        MENUITEM "&Soft Brush",     IDM_OPT_SOFT
        POPUP "S&hape Style"
        BEGIN
            MENUITEM "&Outline",                IDM_SHAPE_OUTLINE
            MENUITEM "&Filled",                 IDM_SHAPE_FILLED
            MENUITEM "Filled with &Outline",    IDM_SHAPE_BOTH
        END
        POPUP "Fill &Tolerance"
        BEGIN
            MENUITEM "&0% (exact match)",   IDM_TOL_0
            MENUITEM "&10%",                IDM_TOL_10
            MENUITEM "&25%",                IDM_TOL_25
            MENUITEM "&50%",                IDM_TOL_50
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About DrawLite", IDM_HELP_ABOUT
    END
END

// Keyboard shortcuts
IDA_MAINACCEL ACCELERATORS
BEGIN
    "N", IDM_FILE_NEW,  VIRTKEY, CONTROL
    "O", IDM_FILE_OPEN, VIRTKEY, CONTROL
    "S", IDM_FILE_SAVE, VIRTKEY, CONTROL
    "Z", IDM_EDIT_UNDO, VIRTKEY, CONTROL
    "Y", IDM_EDIT_REDO, VIRTKEY, CONTROL
END

// About box. Sizes are in dialog units, not pixels, so it scales with the font.
IDD_ABOUT DIALOGEX 0, 0, 180, 100
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DrawLite"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_APP, IDC_STATIC, 74, 12, 32, 32
    CTEXT           "DrawLite v0.11", IDC_STATIC, 20, 52, 140, 8
    CTEXT           "A drawing application for Windows", IDC_STATIC, 7, 64, 166, 8
    DEFPUSHBUTTON   "OK", IDOK, 65, 80, 50, 14
END

// New Image dialog
IDD_NEWIMAGE DIALOGEX 0, 0, 150, 80
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Image"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Width:", IDC_STATIC, 10, 14, 40, 8
    EDITTEXT        IDC_NEW_WIDTH, 55, 12, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "pixels", IDC_STATIC, 110, 14, 30, 8
    LTEXT           "&Height:", IDC_STATIC, 10, 34, 40, 8
    EDITTEXT        IDC_NEW_HEIGHT, 55, 32, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "pixels", IDC_STATIC, 110, 34, 30, 8
    DEFPUSHBUTTON   "OK", IDOK, 35, 58, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 90, 58, 50, 14
END

// Version information. Right click the exe, Properties, Details to see it.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,11,0,0
PRODUCTVERSION  0,11,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Pravin Paratey"
            VALUE "FileDescription",  "DrawLite - a drawing application"
            VALUE "FileVersion",      "0.11.0.0"
            VALUE "InternalName",     "DrawLite"
            VALUE "LegalCopyright",   "Copyright (c) Pravin Paratey"
            VALUE "OriginalFilename", "drawlite.exe"
            VALUE "ProductName",      "DrawLite"
            VALUE "ProductVersion",   "0.11.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
